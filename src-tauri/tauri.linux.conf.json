{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"bundle": {
		"linux": {
			"deb": {
				"conflicts": ["naenae-amll-ttml-tool-fork"],
				"replaces": ["naenae-amll-ttml-tool-fork"],
				"recommends": ["xdg-desktop-portal", "zenity"]
			},
			"rpm": {
				"obsoletes": ["naenae-amll-ttml-tool-fork"],
				"recommends": ["xdg-desktop-portal", "zenity"]
			}
		}
	},
	"app": {
		"windows": [
			{
				"title": "Spicy Lyrics TTML Tool",
				"label": "main",
				"width": 800,
				"height": 600,
				"resizable": true,
				"devtools": true,
				"fullscreen": false,
				"dragDropEnabled": false,
				"visible": false,
				"decorations": true
			}
		]
	}
}
